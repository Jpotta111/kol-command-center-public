# Copy to .env and fill in YOUR OWN values. Never commit .env.
# Keys stay on your computer. Nothing is sent anywhere except the API itself.

# OpenAlex (free). Without a key you can run small searches (about 200 authors).
# With a free key you get more results and a larger daily budget.
# Create one at https://openalex.org (sign in, then account settings).
OPENALEX_API_KEY=
OPENALEX_EMAIL=your_email@example.com

# Optional: Google AI Studio key for AI-written profiles (free tier available).
# Create one at https://aistudio.google.com
GEMINI_API_KEY=
